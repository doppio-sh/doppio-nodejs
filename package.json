{
  "name": "doppio-nodejs",
  "version": "0.10.0",
  "description": "The doppio.sh official library - HTML to PDF - HTML to Screenshot - Templates",
  "homepage": "https://doppio.sh",
  "bugs": {
    "url": "https://github.com/doppio-sh/doppio-nodejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doppio-sh/doppio-nodejs.git"
  },
  "keywords": [
    "doppio",
    "html to pdf",
    "html to screenshot",
    "pdf",
    "templates",
    "screenshot",
    "puppeteer",
    "headless"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "check:package": "tsdown && publint && attw --pack .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run check:package",
    "release": "changeset publish && git push --follow-tags"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Renaud Lataguerra",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.7",
    "@vitest/coverage-v8": "^5.1.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
